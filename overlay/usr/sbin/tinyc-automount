#!/bin/sh
# tinyc-automount add|remove DEVICE : mount a plugged-in drive under /media/NAME, or clean up after it
dev=/dev/$2
case "$1" in
add)
    # not tinyc's own stick (the TINYC part and tinyc-data are already in use)
    label=$ID_FS_LABEL                         # udev tells us the name and type
    case "$label" in TINYC|tinyc-data|tinyc) exit 0 ;; esac
    # the computer's hidden parts: EFI system, Microsoft reserved, Windows recovery
    case "$ID_PART_ENTRY_TYPE" in
        c12a7328-f81f-11d2-ba4b-00a0c93ec93b|e3c9e316-0b5c-4db8-817d-f92df00215ae|de94bba4-06d1-4d40-a16a-bfd50179d6ac|0xef|0x27) exit 0 ;;
    esac
    grep -q "^$dev " /proc/mounts && exit 0
    type=$ID_FS_TYPE
    name=$(printf '%s' "${label:-USB-$2}" | tr '/ ' '__')
    m=/media/$name; n=2; while [ -e "$m" ] && grep -q " $m " /proc/mounts; do m=/media/$name-$n; n=$((n + 1)); done
    mkdir -p "$m"
    case "$type" in
        vfat)  o="-t vfat -o utf8,shortname=mixed,flush" ;;
        exfat) o="-t exfat" ;;
        ntfs)  o="-t ntfs3" ;;
        *)     o="" ;;
    esac
    mount $o "$dev" "$m" 2>/dev/null || { rmdir "$m" 2>/dev/null; exit 1; } ;;
remove)
    m=$(awk -v d="$dev" '$1 == d { print $2 }' /proc/mounts)
    [ -n "$m" ] && { umount -l "$m"; rmdir "$m" 2>/dev/null; } ;;
esac
exit 0
